{
  "openapi": "3.1.0",
  "info": {
    "title": "NLLB-200 Translation Service",
    "description": "HTTP API для перекладу тексту у підтримувані цільові мови за допомогою NLLB-200. Арабська (`arb_Arab`) використовується як типовий приклад вхідного тексту.",
    "contact": {
      "name": "Speech Translate Service"
    },
    "version": "0.3.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Перевірка доступності сервісу",
        "description": "Повертає базовий статус живості застосунку.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/translate": {
      "post": {
        "tags": [
          "translation"
        ],
        "summary": "Переклад тексту у підтримувану мову",
        "description": "Виконує переклад одного тексту (наприклад, арабського `arb_Arab`) у підтримувану цільову мову.",
        "operationId": "translate_translate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranslateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslateResponse"
                }
              }
            }
          },
          "401": {
            "description": "Невалідний або відсутній API ключ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Модель недоступна або не ініціалізувалась.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Опис причини помилки."
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Стандартна помилка API."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TranslateRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Text",
            "description": "Вхідний текст для перекладу (наприклад, арабською `arb_Arab`).",
            "examples": [
              "مرحبا كيف حالك"
            ]
          },
          "target_language": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ru",
                  "uk"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Language",
            "description": "Цільова мова перекладу: `ru` (російська) або `uk` (українська). Якщо не передано, використовується NLLB_DEFAULT_TARGET_LANGUAGE.",
            "examples": [
              "ru",
              "uk"
            ]
          },
          "source_language": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ar",
                  "pl",
                  "sk",
                  "hu",
                  "ro",
                  "md",
                  "be",
                  "ru"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Language",
            "description": "Вхідна мова (alias): `ar`, `pl`, `sk`, `hu`, `ro`, `md`, `be`, `ru`. Якщо не передано, використовується `NLLB_SRC_LANG`.",
            "examples": [
              "ar",
              "pl",
              "ro"
            ]
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TranslateRequest",
        "description": "Запит на переклад одного текстового фрагмента."
      },
      "TranslateResponse": {
        "properties": {
          "translation": {
            "type": "string",
            "title": "Translation",
            "description": "Результат перекладу цільовою мовою."
          },
          "source_language": {
            "type": "string",
            "title": "Source Language",
            "description": "Код вихідної мови у форматі NLLB."
          },
          "target_language": {
            "type": "string",
            "title": "Target Language",
            "description": "Код цільової мови у форматі NLLB."
          },
          "model_name": {
            "type": "string",
            "title": "Model Name",
            "description": "Назва моделі перекладу."
          }
        },
        "type": "object",
        "required": [
          "translation",
          "source_language",
          "target_language",
          "model_name"
        ],
        "title": "TranslateResponse",
        "description": "Успішна відповідь сервісу перекладу."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Службові ендпоінти сервісу."
    },
    {
      "name": "translation",
      "description": "Ендпоінти перекладу тексту."
    }
  ]
}
