STORAGE_PATH=./storage

# ── Модель ────────────────────────────────────────────────────────────────────
# HuggingFace ID моделі (використовується лише для завантаження токенайзера)
NLLB_MODEL_NAME=facebook/nllb-200-distilled-1.3B

# Директорія кешу HuggingFace (токенайзер)
NLLB_MODEL_CACHE_DIR=/app/storage/huggingface

# Завантажувати токенайзер тільки з локального кешу (без звернення до HF Hub)
NLLB_TRANSFORMERS_OFFLINE=0

# ── CTranslate2 ───────────────────────────────────────────────────────────────
# Шлях до сконвертованої CT2 INT8 моделі (перед запуском запустіть scripts/convert_model.py)
NLLB_CT2_MODEL_DIR=/app/storage/ct2-nllb-1.3b-int8

# Пристрій: cpu або cuda
NLLB_CT2_DEVICE=cpu

# Кількість паралельних потоків перекладу (рекомендовано = кількість ядер CPU)
NLLB_CT2_INTER_THREADS=1

# ── Переклад ─────────────────────────────────────────────────────────────────
# Цільова мова за замовчуванням: ru або uk
NLLB_DEFAULT_TARGET_LANGUAGE=ru

# Максимальна довжина генерації (0 = без ліміту, використовується 1024)
NLLB_MAX_LENGTH=1024

# Максимальна довжина вхідного тексту в API-запиті
NLLB_REQUEST_TEXT_MAX_LENGTH=10000

# ── Авторизація ───────────────────────────────────────────────────────────────
NLLB_API_KEY_ENABLED=false
NLLB_API_KEY=change-me

NLLB_BEARER_TOKEN_ENABLED=false
NLLB_BEARER_TOKEN=change-me-token

# ── Rate limit ────────────────────────────────────────────────────────────────
NLLB_RATE_LIMIT_ENABLED=false
NLLB_RATE_LIMIT_REQUESTS=60
NLLB_RATE_LIMIT_WINDOW_SECONDS=60
